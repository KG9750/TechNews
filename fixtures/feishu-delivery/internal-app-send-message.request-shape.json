{
  "notes": [
    "Draft request shape for Feishu internal app bot send-message API.",
    "For /im/v1/messages, body.content is a JSON-serialized string generated from the content_source_file card object.",
    "Custom group bot fallback uses a card object and is documented separately in dry-run evidence.",
    "Do not replace placeholders with real ids in committed files."
  ],
  "user_delivery": {
    "method": "POST",
    "path": "/open-apis/im/v1/messages",
    "query": {
      "receive_id_type": "open_id"
    },
    "headers": {
      "Authorization": "Bearer ${FEISHU_TENANT_ACCESS_TOKEN}",
      "Content-Type": "application/json"
    },
    "content_format": "json_string",
    "content_source_file": "fixtures/feishu-delivery/push-briefing-card-content.json",
    "body": {
      "receive_id": "${FEISHU_DEFAULT_USER_OPEN_ID}",
      "msg_type": "interactive",
      "content": "${JSON_STRINGIFIED_FIXTURE_CARD_CONTENT}"
    }
  },
  "group_delivery": {
    "method": "POST",
    "path": "/open-apis/im/v1/messages",
    "query": {
      "receive_id_type": "chat_id"
    },
    "headers": {
      "Authorization": "Bearer ${FEISHU_TENANT_ACCESS_TOKEN}",
      "Content-Type": "application/json"
    },
    "content_format": "json_string",
    "content_source_file": "fixtures/feishu-delivery/push-briefing-card-content.json",
    "body": {
      "receive_id": "${FEISHU_DEFAULT_CHAT_ID}",
      "msg_type": "interactive",
      "content": "${JSON_STRINGIFIED_FIXTURE_CARD_CONTENT}"
    }
  }
}
